# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=8989
FLASK_SECRET_KEY=change-this-to-a-very-secure-random-32-character-key
WTF_CSRF_SECRET_KEY=change-this-to-another-secure-random-key

# Database Setup
DATABASE_URL=sqlite:///database/secure_login.db

# Cybersecurity Security Policies
# (Threshold of failed attempts before account is locked)
LOCKOUT_ATTEMPTS=5
# (Lockout duration in minutes)
LOCKOUT_MINUTES=10
# (Session inactivity timeout in minutes)
SESSION_TIMEOUT_MINUTES=15

# Rate Limiting Settings
# (Limits requests per minute for login/register actions)
AUTH_RATE_LIMIT=5 per minute
GLOBAL_RATE_LIMIT=60 per minute
